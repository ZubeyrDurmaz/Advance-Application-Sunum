# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/watch_store_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# JWT Configuration
JWT_SECRET=ChronosSecretKeyForJWTTokenGeneration2024MustBeLongEnoughForHS512Algorithm!!
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Anthropic AI Configuration (Optional)
ANTHROPIC_API_KEY=

# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Add .env to .gitignore (already done)
# 4. Restart the backend application
